{
  "name": "dexcode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names runtime,web --prefix-colors blue,magenta \"npm run dev:runtime\" \"npm run dev:web\"",
    "dev:runtime": "node --experimental-strip-types server.ts",
    "start": "node --experimental-strip-types server.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p apps/web/tsconfig.build.json --noEmit",
    "test:web": "vitest run --config apps/web/vite.config.ts",
    "test:dev": "node scripts/dev-smoke.mjs",
    "test": "node --experimental-strip-types --test packages/agent-core/*.test.ts packages/capability-registry/*.test.ts packages/context-engine/*.test.ts packages/conversation-view/*.test.ts packages/llm-client/*.test.ts packages/mcp-client/*.test.ts packages/session-store/*.test.ts packages/workspace-manager/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.102.8",
    "clsx": "^2.1.1",
    "eventsource-parser": "^4.1.0",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.1"
  }
}
