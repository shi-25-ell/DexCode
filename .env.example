# 通用 LLM 配置（适用于 LiteLLM、OpenAI、DeepSeek、豆包等 OpenAI-compatible provider）
LLM_API_KEY=your_api_key_here
LLM_MODEL=your_model_name_here

# OpenAI-compatible 端点 base URL
# LiteLLM proxy: http://localhost:4000
# OpenAI:        https://api.openai.com/v1  （不填时默认此值）
# 豆包:          https://ark.cn-beijing.volces.com/api/v3
LLM_BASE_URL=https://api.openai.com/v1

# 可选：provider 标识，设为 "doubao" 时自动注入 thinking/reasoning_effort 参数
# LLM_PROVIDER=doubao

# 可选：模型调用参数（不填使用内置默认值）
# LLM_TEMPERATURE=0.7
# 模型真实支持的单次输出上限；未知/代理模型建议显式配置。
# 旧的 LLM_MAX_TOKENS 仍作为兼容别名。
# LLM_MAX_OUTPUT_TOKENS=65536
# LLM_TOP_P=0.9
# LLM_TIMEOUT=60000
# LLM_MAX_RETRIES=2
# 主页面展示名称与可信上下文窗口。DexCode 会识别少量官方模型；
# 自定义网关或未知模型必须显式配置窗口和输出上限，避免伪造能力。
# LLM_DISPLAY_NAME=DeepSeek V4 Pro
# LLM_CONTEXT_WINDOW=128000

# 向后兼容别名（LLM_* 未设置时仍生效，无需迁移现有配置）
# DOUBAO_API_KEY=your_doubao_api_key_here
# DOUBAO_MODEL=your_doubao_model_name_here
# DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 可选：指定 Agent 操作的工作区目录（绝对路径），不填时使用默认的 workspaces/demo-project/workspace/
# WORKSPACE_DIR=/path/to/your/project

# 可选：开发服务器端口。npm run dev 会自动让 Vite 代理到对应 Runtime。
# PORT=3000
# WEB_PORT=5173
# RUNTIME_ORIGIN=http://127.0.0.1:3000

# 可选：从产品外壳移除能力入口（mcp,skills,approval,project-knowledge,memory,subagents）
# DEX_DISABLED_CAPABILITIES=project-knowledge

# 可选：Multi-Agent 缺省开启；设为 false 或 off 可关闭。
# MULTI_AGENT_ENABLED=true

# 可选：Managed Memory 模式。off=关闭，observe=运行但不注入上下文，on=完整启用。
# DEXCODE_MANAGED_MEMORY_MODE=on

# 可选：命令工具 shell。Windows 默认 powershell；bash 仅指 Git Bash，不接受 WSL bash.exe。
# DEX_COMMAND_SHELL=powershell
# DEX_POWERSHELL_PATH=C:\Program Files\PowerShell\7\pwsh.exe
# DEX_GIT_BASH_PATH=C:\Program Files\Git\bin\bash.exe

# 可选：禁止 grep 在 rg 缺失时下载托管副本；此时必须预装 rg 或放入托管目录。
# DEXCODE_OFFLINE=1

# 可选：构建 Web UI 时替换品牌 Logo，缺省使用 public/dexcode-logo.svg
# VITE_BRAND_ICON_URL=/my-brand.svg
